[Unit]
Description=CampusVend kiosk screen (full-screen Chromium under cage)
After=systemd-user-sessions.service network-online.target
Wants=network-online.target
Conflicts=getty@tty1.service

[Service]
Type=simple
User=kiosk
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
StandardInput=tty-fail
UtmpIdentifier=tty1
UtmpMode=user
ExecStart=/usr/bin/cage -s -- /opt/campusvend/kiosk-browser.sh
Restart=always
RestartSec=3

[Install]
WantedBy=graphical.target
